{
  "title": "Stay With Me",
  "lines": [
    { "text": "To you~", "start": 0.270, "end": 2.690 },
    { "text": "Yes, my love to you~", "start": 2.690, "end": 7.116 },
    { "text": "Yes, my love to you~~, you~", "start": 7.116, "end": 13.548 },
    { "text": "To you~", "start": 13.548, "end": 22.954 },
    { "text": "Watashi wa watashi~, anata wa anata to~", "start": 22.954, "end": 31.806 },
    { "text": "Yuube itteta sonna ki mo suru wa~", "start": 31.806, "end": 40.728 },
    { "text": "Gurei no jaketto ni~", "start": 40.728, "end": 44.393 },
    { "text": "Mioboe ga aru kouhii no shimi~", "start": 44.393, "end": 49.649 },
    { "text": "Aikawarazu na no ne~", "start": 49.649, "end": 53.107 },
    { "text": "Shou uindou ni futari utsureba~", "start": 53.107, "end": 60.646 },
    { "text": "Stay with me", "start": 60.646, "end": 63.412 },
    { "text": "Mayonaka no doa o tataki~", "start": 63.412, "end": 67.838 },
    { "text": "Kaeranaide to naita~", "start": 67.838, "end": 74.201 },
    { "text": "Ano kisetsu ga ima me no mae~", "start": 74.201, "end": 78.351 },
    { "text": "Stay with me~", "start": 78.351, "end": 81.186 },
    { "text": "Kuchiguse wo ii nagara~", "start": 81.186, "end": 85.405 },
    { "text": "Futari no toki wo daite~", "start": 85.405, "end": 91.906 },
    { "text": "Mada wasurezu Daiji ni shite ita~", "start": 91.906, "end": 105.807 },
    { "text": "Koi to ai to wa chigau monoda yo to~", "start": 105.807, "end": 114.867 },
    { "text": "Yuube iwareta sonna ki mo suru wa~", "start": 114.867, "end": 123.719 },
    { "text": "Nidome no fuyu ga kite~", "start": 123.719, "end": 127.385 },
    { "text": "Hanarete ittaanata no kokoro~", "start": 127.385, "end": 132.710 },
    { "text": "Furi kaereba itsumo~", "start": 132.710, "end": 136.168 },
    { "text": "Soko ni anatawo kanjite ita no~", "start": 136.168, "end": 143.637 },
    { "text": "Stay with me~", "start": 143.637, "end": 146.403 },
    { "text": "Mayonaka no doa o tataki~", "start": 146.403, "end": 150.830 },

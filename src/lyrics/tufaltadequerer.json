{
  "title": "Tu falta de querer",
  "offset": 3,
  "lines": [
    { "text": "Hoy volví", "start": 27, "end": 30 },
    { "text": "A dormir en nuestra cama y todo sigue igual", "start": 30, "end": 35 },
    { "text": "El aire y nuestros gatos nada cambiará", "start": 35, "end": 41 },
    { "text": "Difícil olvidarte estando aquí", "start": 41, "end": 46 },
    { "text": "Ah oh oh", "start": 46, "end": 50 },

    { "text": "Te quiero ver", "start": 50, "end": 52 },
    { "text": "Aún te amo y creo que hasta más que ayer", "start": 52, "end": 58 },
    { "text": "La hiedra venenosa no te deja ver", "start": 58, "end": 63 },
    { "text": "Me siento mutilada y tan pequeña", "start": 63, "end": 69 },
    { "text": "Ah ah ah", "start": 69, "end": 72 },

    { "text": "Ven", "start": 72, "end": 76 },
    { "text": "Y cuéntame la verdad", "start": 76, "end": 81 },
    { "text": "Ten piedad", "start": 81, "end": 87 },
    { "text": "Y dime por qué", "start": 87, "end": 91 },
    { "text": "No no no, oh", "start": 91, "end": 95 },

    { "text": "Cómo fue", "start": 95, "end": 97 },
    { "text": "Que me dejaste de amar", "start": 97, "end": 103 },
    { "text": "Yo no podía soportar", "start": 103, "end": 108 },
    { "text": "Tu tanta falta de querer", "start": 108, "end": 113 },

    { "text": "Hace un mes", "start": 116, "end": 119 },
    { "text": "Solía escucharte y ser tu cómplice", "start": 119, "end": 124 },
    { "text": "Pensé que ya no había nadie más que tú", "start": 124, "end": 130 },
    { "text": "Yo fui tu amiga y fui tu compañera", "start": 130, "end": 135 },
    { "text": "Ah ah ah", "start": 135, "end": 138 },

    { "text": "Ahora dormiré", "start": 138, "end": 141 },
    { "text": "Muy profundamente para olvidar", "start": 141, "end": 147 },
    { "text": "Quisiera hasta la muerte para no pensar", "start": 147, "end": 152 },
    { "text": "Me borro pa' quitarme esta amargura", "start": 152, "end": 157 },
    { "text": "Ah ah ah", "start": 157, "end": 160 },

    { "text": "Ven", "start": 160, "end": 165 },
    { "text": "Y cuéntame la verdad", "start": 165, "end": 170 },
    { "text": "Ten piedad", "start": 170, "end": 176 },
    { "text": "Y dime por qué", "start": 176, "end": 180 },
    { "text": "No no no, oh", "start": 180, "end": 183 },

    { "text": "Cómo fue", "start": 183, "end": 186 },
    { "text": "Que me dejaste de amar", "start": 186, "end": 192 },
    { "text": "Yo no podía soportar", "start": 192, "end": 197 },
    { "text": "Tu tanta falta de querer", "start": 197, "end": 202 },

    { "text": "[Solo de guitarra distorsionada]", "start": 205, "end": 229 },

    { "text": "Ven", "start": 229, "end": 233 },
    { "text": "Y cuéntame la verdad", "start": 233, "end": 238 },
    { "text": "Ten piedad", "start": 238, "end": 244 },
    { "text": "Y dime por qué", "start": 244, "end": 248 },
    { "text": "No no no, oh", "start": 248, "end": 252 },

    { "text": "Cómo fue", "start": 252, "end": 255 },
    { "text": "Que me dejaste de amar", "start": 255, "end": 261 },
    { "text": "Yo no podía soportar", "start": 261, "end": 266 },
    { "text": "Tu tanta falta de querer", "start": 266, "end": 269 }
  ]
}


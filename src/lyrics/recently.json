{
  "title": "Recently",
  "artist": "Clairo",
  "lines": [
    { "text": "[Music]", "start": 2.0, "end": 14.0 },

    { "text": "Do the flowers understand", "start": 14.0, "end": 23.0 },
    { "text": "That we're fine, you and I", "start": 23.0, "end": 26.0 },

    { "text": "Hands are tired", "start": 30.0, "end": 33.0 },
    { "text": "I don't mind, I'll make you be okay", "start": 33.0, "end": 36.0 },

    { "text": "But recently everyone says", "start": 36.0, "end": 40.0 },
    { "text": "They're seeing less of me", "start": 40.0, "end": 44.0 },
    { "text": "I could do better if I had energy", "start": 44.0, "end": 45.0 },
    { "text": "Be like I used to be", "start": 45.0, "end": 49.0 },

    { "text": "And frequently", "start": 49.0, "end": 51.0 },
    { "text": "I picture myself walking straight into the sea", "start": 51.0, "end": 53.0 },
    { "text": "Laughing as the waves come rolling to my knees", "start": 53.0, "end": 55.0 },
    { "text": "What a place to be", "start": 55.0, "end": 56.0 },

    { "text": "Side by side", "start": 56.0, "end": 60.0 },
    { "text": "You keep me safe from their study", "start": 60.0, "end": 64.0 },
    { "text": "Getting through, please be fine", "start": 64.0, "end": 67.0 },

    { "text": "It's too late now", "start": 67.0, "end": 71.0 },
    { "text": "To go leave you behind", "start": 71.0, "end": 74.0 },

    { "text": "But recently everyone says", "start": 74.0, "end": 79.0 },
    { "text": "They're seeing less of me", "start": 79.0, "end": 83.0 },
    { "text": "I could do better if I had energy", "start": 83.0, "end": 86.0 },
    { "text": "Be like I used to be", "start": 86.0, "end": 88.0 },

    { "text": "And frequently", "start": 88.0, "end": 90.0 },
    { "text": "I picture myself walking straight into the sea", "start": 90.0, "end": 92.0 },
    { "text": "Laughing as the waves come rolling to my knees", "start": 92.0, "end": 95.0 },
    { "text": "What a place to be", "start": 95.0, "end": 99.0 },

    { "text": "[Music]", "start": 99.0, "end": 104.0 },

    { "text": "Foreign", "start": 104.0, "end": 108.0 },
    { "text": "And it's a lovely day for swimming", "start": 108.0, "end": 114.0 },
    { "text": "Pretend I didn't see the red flags that said 'Don't go'", "start": 114.0, "end": 119.0 },

    { "text": "[Music]", "start": 119.0, "end": 123.0 },

    { "text": "I'll find it for myself", "start": 123.0, "end": 129.0 },
    { "text": "And not because someone told me so", "start": 129.0, "end": 134.0 },

    { "text": "[Music]", "start": 134.0, "end": 140.0 },

    { "text": "Recently everyone says", "start": 140.0, "end": 144.0 },
    { "text": "They're seeing less of me", "start": 144.0, "end": 147.0 },
    { "text": "I could do better if I had energy", "start": 147.0, "end": 150.0 },
    { "text": "To be like I used to be", "start": 150.0, "end": 153.0 },

    { "text": "And frequently", "start": 153.0, "end": 156.0 },
    { "text": "I'd picture myself walking straight into the sea", "start": 156.0, "end": 159.0 },
    { "text": "Laughing as the lights come rolling to my knees", "start": 159.0, "end": 162.0 },
    { "text": "What a place to be", "start": 162.0, "end": 164.0 }
  ]
}
